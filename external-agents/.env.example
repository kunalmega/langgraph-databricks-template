# Copy to external-agents/.env and fill in. Registers an externally-hosted agent
# (EKS/AKS/GKE/any HTTP endpoint) into Unity Catalog as an external agent service.

# --- Databricks auth ---------------------------------------------------------
DATABRICKS_PROFILE=<your-cli-profile>

# --- Where to register (Unity Catalog) ---------------------------------------
UC_CATALOG=main
UC_SCHEMA=default
CONNECTION_NAME=my_agent_connection      # UC HTTP connection name (created by the script)
AGENT_SERVICE_ID=support_agent           # the agent service id shown in the inventory

# --- The external agent (hosted outside Databricks) --------------------------
AGENT_HOST=https://my-agent.eks.example.com   # base URL of your agent (EKS/AKS/etc.)
AGENT_PORT=443
AGENT_BASE_PATH=/v1/chat                       # path the agent serves chat on
AGENT_SYSTEM_PROMPT=You are a helpful support assistant.
AGENT_COMMENT=Support agent for the customer team

# --- Auth to the external agent ----------------------------------------------
# Prefer a Databricks secret reference over a literal token.
# One-time: databricks secrets create-scope ext_agents && \
#           databricks secrets put-secret ext_agents my_agent_token
AGENT_BEARER_TOKEN_SECRET={{secrets/ext_agents/my_agent_token}}
# Or, for a quick test only (NOT recommended — keep tokens out of files):
# AGENT_BEARER_TOKEN=<raw-token>

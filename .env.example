# ---------------------------------------------------------------------------
# Copy to `.env` and fill in for LOCAL runs. Every value that changes per
# workspace/deployment lives here — this is the only file you edit to reuse
# the template. In a deployed Databricks App these come from app.yaml / the
# runtime instead (see README). Values below are PLACEHOLDERS — replace them.
# ---------------------------------------------------------------------------

# --- Databricks auth (local) -------------------------------------------------
# REQUIRED for local runs. Log in first: databricks auth login --profile <name>
# There is no default — the app fails clearly if this is unset locally.
DATABRICKS_PROFILE=<your-cli-profile>

# --- App --------------------------------------------------------------------
# Name of the Databricks App (also used as the setup scripts' target).
APP_NAME=langgraph-sample

# --- The LLM / Unity AI Gateway ---------------------------------------------
# THE MODEL THE AGENT USES. Change this one line to swap the LLM (see docs/ARCHITECTURE.md).
# It is the name of a Unity AI Gateway endpoint; a foundation-model endpoint name works.
# Examples: databricks-claude-sonnet-5 | databricks-claude-opus-4-8 | databricks-gpt-5-5 | databricks-gemini-3-5-flash
UAIG_ENDPOINT=databricks-claude-sonnet-5

# Friendly name this agent shows as in the gateway usage view (request tags).
AGENT_NAME=langgraph-sample-agent

# --- Lakebase (state store) --------------------------------------------------
# The setup script (setup/01_provision_lakebase.sh) CREATES the project + database.
LAKEBASE_PROJECT=langgraph-sample
PGDATABASE=langgraph_app
# These two are PRINTED by setup/01 — paste them back here after it runs:
#   Autoscaling endpoint path: projects/<project>/branches/production/endpoints/primary
ENDPOINT_NAME=projects/langgraph-sample/branches/production/endpoints/primary
PGHOST=<paste-from-setup-01-output>
# Local runs: your email. Deployed app: the app service-principal client id.
PGUSER=<you@example.com or app-sp-client-id>
PGPORT=5432
PGSSLMODE=require

# --- Unity Catalog target for the registered agent (deploy_agent.py) ---------
UC_CATALOG=<your_catalog>
UC_SCHEMA=<your_schema>

# --- Governed LLM endpoint with fallback (register_llm_gateway.py) -----------
# OPTIONAL. Create your OWN serving endpoint that routes across models with fallback +
# guardrails, then point UAIG_ENDPOINT at it. Needs an API token via a secret reference.
GATEWAY_LLM_ENDPOINT=langgraph-governed-llm
LLM_PRIMARY=databricks-claude-sonnet-5
LLM_FALLBACK=databricks-claude-haiku-4-5
# One-time: databricks secrets create-scope llm && databricks secrets put-secret llm pat
LLM_TOKEN_SECRET={{secrets/llm/pat}}

# --- Optional: Unity AI Gateway model service (primary+fallback) -------------
# If set, the agent routes through this model service instead of UAIG_ENDPOINT.
# MODEL_SERVICE_AUTH: "token" (default; requires MODEL_SERVICE_TOKEN) or "oauth".
# MODEL_SERVICE=<catalog>.<schema>.<model_service_name>
# MODEL_SERVICE_AUTH=token
# MODEL_SERVICE_TOKEN={{secrets/llm/model_service_token}}

# --- Operational toggles (safe defaults) ------------------------------------
# Require the forwarded end-user identity on /api/chat (recommended for multi-tenant).
REQUIRE_CALLER_IDENTITY=false
# The one-time /api/setup DDL route is OFF by default. Enable only for a bootstrap
# run, then set back to false. Prefer the setup/ scripts for provisioning.
ENABLE_SETUP_ROUTE=false

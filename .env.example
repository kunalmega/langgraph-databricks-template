# ---------------------------------------------------------------------------
# Copy to `.env` and fill in for LOCAL runs. Every value that changes per
# workspace/deployment lives here — this is the only file you edit to reuse
# the template. In a deployed Databricks App these come from app.yaml / the
# runtime instead (see README).
# ---------------------------------------------------------------------------

# --- Databricks auth (local) -------------------------------------------------
# CLI profile for your FEVM/serverless workspace (run: databricks auth login --profile <name>)
DATABRICKS_PROFILE=Fevm-fevm-conde

# --- App --------------------------------------------------------------------
# Name of the Databricks App (also used as the setup scripts' target).
APP_NAME=langgraph-sample

# --- The LLM / Unity AI Gateway ---------------------------------------------
# THE MODEL THE AGENT USES. Change this one line to swap the LLM (see docs/ARCHITECTURE.md).
# It is the name of a Unity AI Gateway endpoint; a foundation-model endpoint name works.
# Examples: databricks-claude-sonnet-5 | databricks-claude-opus-4-8 | databricks-gpt-5-5 | databricks-gemini-3-5-flash
UAIG_ENDPOINT=databricks-claude-sonnet-5

# Friendly name this agent shows as in the gateway usage view (request tags).
AGENT_NAME=langgraph-sample-agent

# --- Lakebase (state store) --------------------------------------------------
# The setup script (setup/01_provision_lakebase.sh) CREATES the project + database.
LAKEBASE_PROJECT=langgraph-sample
PGDATABASE=langgraph_app
# These two are PRINTED by setup/01 — paste them back here after it runs:
#   Autoscaling endpoint path: projects/<project>/branches/production/endpoints/primary
ENDPOINT_NAME=projects/langgraph-sample/branches/production/endpoints/primary
PGHOST=<paste-from-setup-01-output>
# Local runs: your email. Deployed app: the app service-principal client id.
PGUSER=you@example.com
PGPORT=5432
PGSSLMODE=require

# --- Unity Catalog target for the registered agent (deploy_agent.py) ---------
UC_CATALOG=fevm_cme_conde_catalog
UC_SCHEMA=langgraph_demo
